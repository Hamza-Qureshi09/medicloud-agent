# -- Machine Agent details
MEDICLOUD_MACHINES_SDK_DB_PATH=./data/machines.db
MEDICLOUD_MACHINES_INTERNAL_HTTP_ENABLED=false
MEDICLOUD_AGENT_HTTP_HOST=localhost
MEDICLOUD_AGENT_HTTP_PORT=5001
SERIAL_TRACE=false

# -- Agent Mode (direct | master | slave) --
AGENT_MODE=direct

# # -- MediCloud connection (direct + master modes only) --
# MEDICLOUD_AGENT_ID=snv
# MEDICLOUD_AGENT_SECRET=sfdgsd
# MEDICLOUD_ACCOUNT_ID=sdfgsdfg
# MEDICLOUD_API_URL=https://v1.medicloud.ly
# AGENT_PUBLIC_URL=http://localhost:5001
# MEDICLOUD_PING_INTERVAL_MS=30000

# -- Order/Results Pull/Ping intervals --
# DEFAULT_ORDER_PULL_INTERVAL_MS= 10_000; # after 10 sec pull data

# # -- Slave mode only --
# MASTER_HOST=192.168.1.100   # static ip never changed
# MASTER_PORT=5001
# SLAVE_BOOTSTRAP_SECRET=

# -- Agent Medicloud DB (separate from machines.db) --
MEDICLOUD_DB_PATH=./data/agentMedicloud.db