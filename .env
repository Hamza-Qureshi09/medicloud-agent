
# -- Machine Agent details
MEDICLOUD_MACHINES_SDK_DB_PATH=./data/machines.db
MEDICLOUD_MACHINES_INTERNAL_HTTP_ENABLED=false
MEDICLOUD_AGENT_HTTP_HOST="0.0.0.0"
MEDICLOUD_AGENT_HTTP_PORT=5001
SERIAL_TRACE=false

# -- Agent Mode (direct | master | slave) --
AGENT_MODE=slave

# # -- MediCloud connection (direct + master modes only) --
# MEDICLOUD_AGENT_ID="6ace42536e0de108d6479226"
# MEDICLOUD_AGENT_SECRET="c16937c7-df0e-4b23-a4e9-87336be3cbf0037b7a26-0320-40aa-a73c-00519d041052"
# MEDICLOUD_ACCOUNT_ID="69f34461a9a3a3a654b59e84"
# # MEDICLOUD_API_URL=http://localhost:3742
# MEDICLOUD_API_URL=https://b21a-39-50-166-32.ngrok-free.app
MEDICLOUD_PING_INTERVAL_MS=30000

# -- Order/Results Pull/Ping intervals --
# after 10 sec pull data
DEFAULT_ORDER_PULL_INTERVAL_MS=10000

# # -- Slave mode only --
# MASTER_HOST=192.168.2.10   # static ip never changed
# MASTER_PORT=5001
# SLAVE_ID="31ee44d7-24b4-410e-a4e0-6914e9825e84"
# SLAVE_SECRET="899355f9-4d6b-4bbe-9eb4-a18475d9552e8c15663a-1332-44d2-948f-1e10078dce3b"

# -- Agent Medicloud DB (separate from machines.db) --
MEDICLOUD_AGENT_DB_PATH=./data/agent.db
